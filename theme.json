{
  "name": "jikasei",
  "short": "jikasei",
  "description": "自家制の极简探针（Monitor）主题。",
  "version": "1.18.0",
  "author": "akanotanin",
  "url": "https://github.com/akanotanin/monitor-theme-jikasei",
  "config": [
    {
      "type": "title",
      "label": "顶栏"
    },
    {
      "type": "string",
      "key": "siteIcon",
      "label": "站点图标",
      "default": "/site-icon.png",
      "help": "站名左边那枚圆形图标，也是浏览器标签页与书签的图标。"
    },
    {
      "type": "string",
      "key": "farmUrl",
      "label": "养鸡场入口",
      "default": "",
      "help": "留空＝自动探测本站 /chicken/；填 off＝不显示入口；填地址＝指向别处（同域路径或完整网址）。"
    },
    {
      "type": "title",
      "label": "列表与卡片"
    },
    {
      "type": "select",
      "key": "listTop",
      "label": "列表页顶部",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "都不显示"
        },
        {
          "value": "groups",
          "label": "只显示分组标签"
        },
        {
          "value": "summary",
          "label": "只显示概览卡片·原版"
        },
        {
          "value": "budget",
          "label": "只显示概览卡片·价值版"
        },
        {
          "value": "both",
          "label": "两个都显示·概览卡片原版"
        },
        {
          "value": "bothBudget",
          "label": "两个都显示·概览卡片价值版"
        }
      ],
      "help": "分组标签 = 全部 / 各组那一行；概览卡片 = 那行统计卡片，分原版与月度预算剩余价值版两种排法。"
    },
    {
      "type": "select",
      "key": "cardStyle",
      "label": "卡片形态",
      "default": "plain",
      "options": [
        {
          "value": "classic",
          "label": "经典：网络速率与总量分两行，不含延迟"
        },
        {
          "value": "plain",
          "label": "简约：网络合成一行，标签提亮、进度条更细，不含延迟"
        },
        {
          "value": "latency",
          "label": "延迟：网络合成一行，下方带三网延迟"
        },
        {
          "value": "detailed",
          "label": "详细：在延迟之上再加在线时长、价格与到期"
        },
        {
          "value": "compact",
          "label": "紧凑：一行一台的表格，密度最高"
        }
      ],
      "help": "经典＝速率与总量各一行；简约＝网络一行、标签提亮；延迟＝加三网延迟；详细＝加时长与计费；紧凑＝表格。"
    },
    {
      "type": "title",
      "label": "备注怎么用：在探针后台的节点里填「公开备注」（访客看得见）与「私有备注」（只有自己看得见，需 hub ≥ 1.3.2）；逗号分隔＝多枚小标签，留空＝那一处不显示；两者在卡片与详情页合并成一串。"
    },
    {
      "type": "select",
      "key": "remarkPlacement",
      "label": "备注显示位置",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "卡片与详情页都显示"
        },
        {
          "value": "card",
          "label": "只在卡片上显示"
        },
        {
          "value": "detail",
          "label": "只在整页详情里显示"
        }
      ],
      "help": "卡片＝列表里那几处（含紧凑展开行）；详情页＝点进去的那一整页。"
    },
    {
      "type": "title",
      "label": "三网延迟"
    },
    {
      "type": "text",
      "key": "pingLines",
      "label": "显示的延迟线路",
      "default": "",
      "help": "每行一个 ping 任务名，最多三条；留空自动取前三条。"
    }
  ]
}
