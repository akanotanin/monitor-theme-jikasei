{
  "name": "jikasei",
  "short": "jikasei",
  "description": "自家制の极简探针（Monitor）主题：五种卡片形态、节点地球、分组筛选、明暗双色。",
  "version": "1.26.4",
  "author": "akanotanin",
  "url": "https://github.com/akanotanin/monitor-theme-jikasei",
  "config": [
    {
      "type": "title",
      "label": "列表与卡片"
    },
    {
      "type": "boolean",
      "key": "globeOn",
      "label": "节点地球",
      "default": true,
      "help": "列表页顶部那颗会自转的地球；关掉＝整块不渲染，顶栏那枚开关也一起收起（开着时访客可自行关）。"
    },
    {
      "type": "select",
      "key": "listTop",
      "label": "列表页顶部",
      "default": "bothBudget",
      "options": [
        {
          "value": "none",
          "label": "都不显示"
        },
        {
          "value": "groups",
          "label": "只显示分组标签"
        },
        {
          "value": "summary",
          "label": "只显示概览卡片·原版"
        },
        {
          "value": "budget",
          "label": "只显示概览卡片·价值版"
        },
        {
          "value": "both",
          "label": "两个都显示·概览卡片原版"
        },
        {
          "value": "bothBudget",
          "label": "两个都显示·概览卡片价值版"
        }
      ],
      "help": "分组标签行与概览卡片行各要哪一档；概览卡片分原版与价值版两种排法。"
    },
    {
      "type": "select",
      "key": "cardStyle",
      "label": "卡片形态",
      "default": "detailed",
      "options": [
        {
          "value": "classic",
          "label": "经典：网络速率与总量分两行，延迟收在右上角浮层里"
        },
        {
          "value": "plain",
          "label": "简约：网络合成一行，标签提亮、进度条更细，不含延迟"
        },
        {
          "value": "latency",
          "label": "延迟：网络合成一行，下方带三网延迟"
        },
        {
          "value": "detailed",
          "label": "详细：在延迟之上再加在线时长、价格与到期"
        },
        {
          "value": "compact",
          "label": "紧凑：一行一台的表格，密度最高"
        }
      ],
      "help": "访客默认看到的档位；访客可在顶栏自行更换。"
    },
    {
      "type": "title",
      "label": "节点信息"
    },
    {
      "type": "select",
      "key": "remarkPlacement",
      "label": "备注显示位置",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "卡片与详情页都显示"
        },
        {
          "value": "card",
          "label": "只在卡片上显示"
        },
        {
          "value": "detail",
          "label": "只在整页详情里显示"
        },
        {
          "value": "none",
          "label": "都不显示"
        }
      ],
      "help": "备注在后台节点里填（公开给访客、私有给自己）；卡片与详情页都摊，逗号分隔＝多枚标签，留空＝不显示。"
    },
    {
      "type": "text",
      "key": "pingLines",
      "label": "显示的延迟线路",
      "default": "",
      "help": "每行一个 ping 任务名，最多三条；留空自动取前三条。"
    },
    {
      "type": "title",
      "label": "外观"
    },
    {
      "type": "select",
      "key": "themeMode",
      "label": "主题模式",
      "default": "system",
      "options": [
        {
          "value": "system",
          "label": "随系统设置"
        },
        {
          "value": "auto",
          "label": "随北京时间自动切换"
        },
        {
          "value": "light",
          "label": "亮色"
        },
        {
          "value": "dark",
          "label": "暗色"
        }
      ],
      "help": "站点明暗；按北京时间自动那档＝19:00–07:00 用暗色（访客可自行覆盖）。"
    }
  ]
}
