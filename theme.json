{
  "name": "jikasei",
  "short": "jikasei",
  "description": "自家制の极简探针（Monitor）主题。",
  "version": "1.5.0",
  "author": "akanotanin",
  "url": "https://github.com/akanotanin/monitor-theme-jikasei",
  "config": [
    {
      "type": "title",
      "label": "顶栏"
    },
    {
      "type": "string",
      "key": "siteIcon",
      "label": "站点图标",
      "default": "/site-icon.png",
      "help": "站名左边那枚圆形图标，也是浏览器标签页与书签的图标。"
    },
    {
      "type": "boolean",
      "key": "showFarmEntry",
      "label": "显示养鸡场入口",
      "default": true,
      "help": "顶栏那枚「养鸡场」图标的开关。"
    },
    {
      "type": "string",
      "key": "farmUrl",
      "label": "养鸡场地址",
      "default": "",
      "help": "留空 = 自动认本站 /chicken/，也可填别处地址。"
    },
    {
      "type": "title",
      "label": "列表与卡片"
    },
    {
      "type": "select",
      "key": "cardStyle",
      "label": "卡片形态",
      "default": "classic",
      "options": [
        { "value": "classic", "label": "经典：网络速率与总量分两行，不含延迟" },
        { "value": "latency", "label": "延迟：网络合成一行，下方带三网延迟" },
        { "value": "detailed", "label": "详细：在延迟之上再加在线时长、价格与到期" }
      ],
      "help": "经典最紧凑；延迟合一行并挂三网延迟；详细再加时长与计费。"
    },
    {
      "type": "select",
      "key": "listTop",
      "label": "列表页顶部",
      "default": "none",
      "options": [
        { "value": "none", "label": "都不显示" },
        { "value": "groups", "label": "只显示分组标签" },
        { "value": "summary", "label": "只显示概览卡片" },
        { "value": "both", "label": "两个都显示" }
      ],
      "help": "分组标签 = 全部 / 各组那一行；概览卡片 = 四张统计卡片。"
    },
    {
      "type": "title",
      "label": "三网延迟"
    },
    {
      "type": "text",
      "key": "pingLines",
      "label": "显示的延迟线路",
      "default": "",
      "help": "每行一个 ping 任务名，最多三条；留空自动取前三条。"
    }
  ]
}
